# Historical server implementation only. GitHub Pages and npm run dev need none of these settings.
# Local server defaults. Production is enabled only by the legacy npm start command.
HOST=127.0.0.1
PORT=3001
FANJIN_DB_PATH=./data/fanjin.sqlite
FANJIN_BACKUP_DIR=./data/backups
SEED_DEMO=0
# Only enable when the app is accessible exclusively through one trusted reverse proxy.
TRUST_PROXY=0
AUTH_REGISTER_LIMIT=10
CORS_ORIGINS=https://fanjin.curatix.tech
# Set a unique administrator name and a random 12–128 character password before first production start.
# These variables initialize a new installation only. Do not put credentials in Git.
ADMIN_NAME=
ADMIN_PASSWORD=
